      "parent": 15,
      "group": "",
      "doc": "Причина прекращения: 2 - \"о прекращении трудовых отношений\"; 3 - \"о смерти ребенка\"; 5 - \"иное\"; 7 - \"невозможность осуществления ухода за ребенком в связи с болезнью получателя\"; 8 - \"замена на отпуск по БиР\"",
      "kind": "element",
      "min": "1",
      "max": "1",
      "type": "",
      "base": "xs:string",
      "facets": [],
      "values": [
        [
          "2",
          "о прекращении трудовых отношений"
        ],
        [
          "3",
          "о смерти ребенка"
        ],
        [
          "5",
          "иное"
        ],
        [
          "7",
