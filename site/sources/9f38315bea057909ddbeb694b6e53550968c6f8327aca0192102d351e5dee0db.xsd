					<xs:restriction base="xs:string">
						<xs:maxLength value="6"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="addressGarType">
		<xs:annotation>
			<xs:documentation>Адрес (в представлении ГАР uuid)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="houseGuid" type="uuidV1Type">
					<xs:annotation>
						<xs:documentation>Соответствие ГАР: Если указан дом: HOUSEGUID – Глобальный уникальный идентификатор дома</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:sequence>
					<xs:element name="guid" type="uuidV1Type">
						<xs:annotation>
							<xs:documentation>Соответствие ГАР: Если не указан дом: AOGUID - Guid записи родительского объекта (улицы, города, населенного пункта, планировочной структуры и т.п.)</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="house" type="stringMinLen1MaxLen30" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Номер дома</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="stroenie" type="stringMinLen1MaxLen30" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Строение</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="building" type="stringMinLen1MaxLen30" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Корпус</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:choice>
			<xs:element name="flat" type="stringMinLen1MaxLen30" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Квартира</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MethodReceivePaymentVolunteerType">
		<xs:annotation>
			<xs:documentation>Способ получения выплаты</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="bankInfo" type="bankInfoType"/>
			<xs:element name="cardMir" type="cardMirType"/>
			<xs:element name="postalAddress" type="postalAddressType">
				<xs:annotation>
					<xs:documentation>Адрес доставки пособия получателю</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:simpleType name="lnCode">
		<xs:annotation>
			<xs:documentation>Номер ЭЛН</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="12"/>
			<xs:pattern value="\d{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="phoneNumberType">
		<xs:restriction base="xs:string">
			<xs:minLength value="5"/>
			<xs:maxLength value="30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="kbkType">
		<xs:restriction base="xs:string">
			<xs:length value="20"/>
			<xs:pattern value="[A-ZА-Я0-9]{20}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="accountNumInFederalExchequerType">
		<xs:restriction base="xs:string">
			<xs:minLength value="5"/>
			<xs:maxLength value="20"/>
			<xs:pattern value="[\dA-Za-zА-Яа-яёЁ.-]{5,20}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="personalInsuredAccountType">
		<xs:restriction base="xs:string">
			<xs:length value="11"/>
			<xs:pattern value="\d{11}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="personalOrgAccountType">
		<xs:restriction base="xs:string">
			<xs:length value="11"/>
			<xs:pattern value="\d{5}[A-ZА-Я0-9]{5}\d{1}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="fixedTrueType">
		<xs:restriction base="xs:boolean">
			<xs:pattern value="true"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="specVersionType">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="responseStatusType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="RECEIVED">
				<xs:annotation>
					<xs:documentation>Сообщение получено СФР, принято к обработке. Осуществляется проверка данных. Результат будет направлен дополнительно</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ERROR">
				<xs:annotation>
					<xs:documentation>В процессе обработки сообщения были обнаружены ошибки форматно-логических контролей, блокирующие прием сообщения</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROCESSED">
				<xs:annotation>
					<xs:documentation>Сообщение успешно обработано</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="responseStatusType2">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ERROR">
				<xs:annotation>
					<xs:documentation>В процессе обработки сообщения были обнаружены ошибки форматно-логических контролей, блокирующие прием сообщения</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROCESSED">
				<xs:annotation>
					<xs:documentation>Сообщение успешно обработано</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="proactiveProcessNumType">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="25"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="measureNumType">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="25"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="batchNoType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[C|E|P]_\d{10}_(19|20)[0-9]{2}_[0|1][0-9]_[0-3][0-9]_\d{1,9}[\S]{0,5}:\d{1,3}|\S{18}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="errorInfoType">
		<xs:sequence>
			<xs:element name="errorList">
				<xs:annotation>
					<xs:documentation>Список ошибок форматно-логических контролей</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="error" type="errorType" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Ошибка форматно-логического контроля</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
				</xs:annotation>
			</xs:any>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="warnInfoType">
		<xs:sequence>
			<xs:element name="warnList">
				<xs:annotation>
					<xs:documentation>Список предупреждений форматно-логических контролей</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="warn" type="warnType" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Предупреждение форматно-логического контроля</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
				</xs:annotation>
			</xs:any>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="sumType">
		<xs:restriction base="xs:decimal">
			<xs:fractionDigits value="2"/>
			<xs:totalDigits value="11"/>
			<xs:pattern value="\d{1,9}([\.]\d{1,2})?"/>
