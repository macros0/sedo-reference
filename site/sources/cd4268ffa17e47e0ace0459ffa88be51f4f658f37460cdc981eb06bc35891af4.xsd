<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:ru:ecp:integration:vnim:noticeTermination05:response:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" xmlns:p="urn:ru:ecp:integration:types:person:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:noticeTermination05:response:v3.0">
	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>
	<xs:import namespace="urn:ru:ecp:integration:types:person:v3.0" schemaLocation="../../type/Person.xsd"/>
	<xs:element name="noticeTermination05Response">
		<xs:annotation>
			<xs:documentation>Результат обработки уведомления о прекращении права застрахованного лица на получение ежемесячного пособия по уходу за ребенком.
Тип сообщения СЭДО №10610</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="status" type="responseStatus">
					<xs:annotation>
						<xs:documentation>Статус обработки сообщения №10410</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="errorList" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Информация об ошибках. Блок заполняется при статусе обработки "ERROR"</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="error" type="com:errorType" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Ошибка форматно-логического контроля</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="warnList" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Информация о предупреждениях форматно-логических контролей</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="warn" type="com:warnType" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Предупреждение форматно-логического контроля</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="specVersion" type="com:specVersionType" use="required">
				<xs:annotation>
					<xs:documentation>Номер версии  спецификации для xml документа</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">
				<xs:annotation>
					<xs:documentation>Ссылка на транспортный идентификатор запроса (тип сообщения СЭДО №10410)</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">
				<xs:annotation>
					<xs:documentation>Дата и время формирования ответного сообщения на стороне СФР</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="skip">
				<xs:annotation>
					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>
				</xs:annotation>
			</xs:anyAttribute>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="responseStatus">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ERROR">
				<xs:annotation>
					<xs:documentation>В процессе обработки сообщения были обнаружены ошибки форматно-логических контролей, блокирующие прием сообщения</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROCESSED">
				<xs:annotation>
					<xs:documentation>Сообщение успешно обработано</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
