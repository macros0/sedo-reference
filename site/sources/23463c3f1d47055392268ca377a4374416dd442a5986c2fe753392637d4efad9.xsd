                                                        <xs:documentation>Уведомление о факте излишне уплаченных страховых взносов, пеней</xs:documentation>
                                                    </xs:annotation>
                                                </xs:enumeration>
                                                <xs:enumeration value="2">
                                                    <xs:annotation>
                                                        <xs:documentation>Уведомление о факте излишне взысканных страховых взносов, пеней</xs:documentation>
                                                    </xs:annotation>
                                                </xs:enumeration>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:element>
