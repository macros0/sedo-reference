                                                <xs:element name="overKbkCode">
                                                    <xs:annotation>
                                                        <xs:documentation>Код КБК зачисления</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:simpleType>
                                                        <xs:restriction base="xs:string">
                                                            <xs:length value="20"/>
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:element>
                                                <xs:element name="overKbkName" type="xs:string">
                                                    <xs:annotation>
                                                        <xs:documentation>Наименование КБК зачисления</xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
