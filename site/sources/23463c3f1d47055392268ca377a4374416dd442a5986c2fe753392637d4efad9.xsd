                                            <xs:restriction base="xs:int">
                                                <xs:enumeration value="1">
                                                    <xs:annotation>
                                                        <xs:documentation>Решение о возврате суммы излишне уплаченных страховых взносов, пеней и штрафов в Фонд пенсионного и социального страхования Российской Федерации</xs:documentation>
                                                    </xs:annotation>
                                                </xs:enumeration>
                                                <xs:enumeration value="2">
                                                    <xs:annotation>
                                                        <xs:documentation>Решение о возврате суммы излишне взысканных страховых взносов, пеней и штрафов в Фонд пенсионного и социального страхования Российской Федерации</xs:documentation>
                                                    </xs:annotation>
                                                </xs:enumeration>
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:element>
                                    <xs:element name="overDcResultId">
