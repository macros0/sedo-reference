<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2021 (x64) (http://www.altova.com) by BFT-Razrabotka (BFT-Razrabotka) --><xs:schema xmlns="urn:ru:ecp:integration:vnim:notice:response:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" xmlns:p="urn:ru:ecp:integration:types:person:v3.0" xmlns:org="urn:ru:ecp:integration:types:organization:v3.0" xmlns:notice="urn:ru:ecp:integration:vnim:notice:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:notice:response:v3.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:person:v3.0" schemaLocation="../../type/Person.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:organization:v3.0" schemaLocation="../../type/Organization.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:vnim:notice:v3.0" schemaLocation="../Notice.xsd"/>	<xs:element name="noticeResponse">		<xs:annotation>			<xs:documentation>Ответ на запрос уточненных сведений для выплаты пособий по ВНиМ, ССВ.Тип сообщения СЭДО №33</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="noticeNumber" type="notice:noticeNumberType">					<xs:annotation>						<xs:documentation>Номер запроса</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="insuredInfo">					<xs:annotation>						<xs:documentation>Данные о застрахованном лице</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="snils" type="p:snils">								<xs:annotation>									<xs:documentation>СНИЛС застрахованного лица</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="insurerInfo">					<xs:annotation>						<xs:documentation>Данные о страхователе</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="regNumSFR" type="org:regNumSFR">								<xs:annotation>									<xs:documentation>Единый рег. номер страхователя СФР</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="informationResponse">					<xs:annotation>						<xs:documentation>Ответ на запрос информации о недостающих сведениях, необходимых для назначения и выплаты пособия</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:choice>							<xs:element name="information">								<xs:annotation>									<xs:documentation>Информация о недостающих сведениях, необходимых для назначения и выплаты пособия</xs:documentation>								</xs:annotation>								<xs:complexType>									<xs:sequence>										<xs:element name="receivePayment" type="com:receivePaymentType" minOccurs="0">											<xs:annotation>												<xs:documentation>Данные о способе получения выплаты</xs:documentation>											</xs:annotation>										</xs:element>										<xs:element name="insuredInfo" minOccurs="0">											<xs:annotation>												<xs:documentation>Данные о застрахованном лице</xs:documentation>											</xs:annotation>											<xs:complexType>												<xs:sequence>													<xs:element name="fullName" type="p:fullName" minOccurs="0">														<xs:annotation>															<xs:documentation>ФИО</xs:documentation>														</xs:annotation>													</xs:element>													<xs:element name="birthDate" type="xs:date" minOccurs="0">														<xs:annotation>															<xs:documentation>Дата рождения</xs:documentation>														</xs:annotation>													</xs:element>												</xs:sequence>											</xs:complexType>										</xs:element>									</xs:sequence>								</xs:complexType>							</xs:element>							<xs:element name="noInformation" type="com:fixedTrueType">								<xs:annotation>									<xs:documentation>Предоставление информации не требуется.При данном виде ответа необходимо заполнить поле "Примечание / причина"</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="refusal" type="com:fixedTrueType">								<xs:annotation>									<xs:documentation>Отказ в назначении пособия.При данном виде ответа необходимо заполнить поле "Примечание / причина"</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="responseWillBeSentNewDoc" type="com:fixedTrueType">								<xs:annotation>									<xs:documentation>Ответ на запрос будет направлен в рамках нового документа (реестра)</xs:documentation>								</xs:annotation>							</xs:element>						</xs:choice>					</xs:complexType>				</xs:element>				<xs:element name="note" type="noteType" minOccurs="0">					<xs:annotation>						<xs:documentation>Примечание / причина</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="senderInfo" type="senderInfoTypeResponse">					<xs:annotation>						<xs:documentation>Сведения об отправителе ответа на извещение (представителе страхователя)</xs:documentation>					</xs:annotation>				</xs:element>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор запроса (тип сообщения СЭДО №32)</xs:documentation>				</xs:annotation>			</xs:attribute>		</xs:complexType>	</xs:element>	<xs:complexType name="senderInfoTypeResponse">		<xs:sequence>			<xs:element name="author" type="p:fullName">				<xs:annotation>					<xs:documentation>ФИО</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="email" type="com:emailAddress">				<xs:annotation>					<xs:documentation>Адрес электронной почты</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="phoneNumber" type="com:phoneNumberType">				<xs:annotation>					<xs:documentation>Номер телефона</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType>	<xs:simpleType name="noteType">		<xs:restriction base="xs:string">			<xs:minLength value="1"/>			<xs:maxLength value="500"/>		</xs:restriction>	</xs:simpleType></xs:schema>
