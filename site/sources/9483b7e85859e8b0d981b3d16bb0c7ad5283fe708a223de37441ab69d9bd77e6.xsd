<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns="urn:ru:ecp:integration:vnim:notice:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" xmlns:p="urn:ru:ecp:integration:types:person:v3.0" xmlns:org="urn:ru:ecp:integration:types:organization:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:notice:v3.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../type/Common.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:person:v3.0" schemaLocation="../type/Person.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:organization:v3.0" schemaLocation="../type/Organization.xsd"/>	<xs:element name="notice">		<xs:annotation>			<xs:documentation>Извещение о запросе недостающих сведений для назначения пособий по ВНиМ, ССВ.Тип сообщения СЭДО №1010.Для ответа на данное извещение необходимо направить новый документ по пособию (сообщение с типом СЭДО №101 / электронный реестр по ССВ)</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="noticeNumber" type="noticeNumberType">					<xs:annotation>						<xs:documentation>Номер извещения</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="noticeDate" type="xs:date">					<xs:annotation>						<xs:documentation>Дата формирования извещения</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="noticeReason" type="noticeReasonType">					<xs:annotation>						<xs:documentation>Основание для направления извещения (НПА)</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="tof" type="com:territorialDivision">					<xs:annotation>						<xs:documentation>Территориальное подразделение СФР РФ</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="registryNum" minOccurs="0">					<xs:annotation>						<xs:documentation>Номер реестра (при наличии)</xs:documentation>					</xs:annotation>					<xs:simpleType>						<xs:restriction base="xs:string">							<xs:minLength value="1"/>							<xs:maxLength value="100"/>						</xs:restriction>					</xs:simpleType>				</xs:element>				<xs:element name="insurerInfo" type="insurerInfoTypeRequest">					<xs:annotation>						<xs:documentation>Данные о страхователе</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="benefit" maxOccurs="unbounded">					<xs:annotation>						<xs:documentation>Сведения по пособию и запросу</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="benefitInfo" type="benefitInfoTypeRequest">								<xs:annotation>									<xs:documentation>Данные о пособии</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="insuredInfo" type="insuredInfoTypeRequest">								<xs:annotation>									<xs:documentation>Данные о застрахованном лице</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="informationRequest">								<xs:annotation>									<xs:documentation>Запрос информации о недостающих сведениях, необходимых для назначения и выплаты пособия</xs:documentation>								</xs:annotation>								<xs:complexType>									<xs:sequence>										<xs:element name="item" maxOccurs="unbounded">											<xs:annotation>												<xs:documentation>Недостающее сведение, необходимое для назначения и выплаты пособия</xs:documentation>											</xs:annotation>											<xs:complexType>												<xs:sequence>													<xs:element name="requestText">														<xs:annotation>															<xs:documentation>Текст запроса недостающего сведения</xs:documentation>														</xs:annotation>														<xs:simpleType>															<xs:restriction base="requestTextType"/>														</xs:simpleType>													</xs:element>													<xs:element name="requestFields" type="fieldType" minOccurs="0">														<xs:annotation>															<xs:documentation>Запрашиваемые поля (атрибуты), которые должны быть направлены в сообщении №101 / электронном реестре по ССВ в ответ на извещение</xs:documentation>														</xs:annotation>													</xs:element>												</xs:sequence>											</xs:complexType>										</xs:element>									</xs:sequence>								</xs:complexType>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="senderInfo">					<xs:annotation>						<xs:documentation>Данные лица, направившего извещение</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="fullName" type="p:fullNameSimple">								<xs:annotation>									<xs:documentation>ФИО работника СФР, направившего извещение</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="role" type="com:roleType">								<xs:annotation>									<xs:documentation>Должность</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="phone" type="com:phoneNumberType">								<xs:annotation>									<xs:documentation>Контактный номер телефона</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="signatoryInfo">					<xs:annotation>						<xs:documentation>Данные лица, подписавшего извещение</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="fullName" type="p:fullNameSimple">								<xs:annotation>									<xs:documentation>ФИО работника СФР, подписавшего извещение</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="role" type="com:roleType">								<xs:annotation>									<xs:documentation>Должность</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">					<xs:annotation>						<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>					</xs:annotation>				</xs:any>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageUuid101" type="com:uuidV1Type">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор сообщения СЭДО №101 (при наличии)</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">				<xs:annotation>					<xs:documentation>Дата и время формирования сообщения на стороне СФР</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:anyAttribute processContents="skip">				<xs:annotation>					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>				</xs:annotation>			</xs:anyAttribute>		</xs:complexType>	</xs:element>	<xs:complexType name="insuredInfoTypeRequest">		<xs:sequence>			<xs:element name="snils" type="p:snils">				<xs:annotation>					<xs:documentation>СНИЛС застрахованного лица</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="fullName" type="p:fullName">				<xs:annotation>					<xs:documentation>ФИО</xs:documentation>				</xs:annotation>			</xs:element>			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">				<xs:annotation>					<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>				</xs:annotation>			</xs:any>		</xs:sequence>	</xs:complexType>	<xs:complexType name="insurerInfoTypeRequest">		<xs:sequence>			<xs:element name="regNumSFR" type="org:regNumSFR">				<xs:annotation>					<xs:documentation>Единый рег. номер страхователя СФР</xs:documentation>				</xs:annotation>			</xs:element>			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">				<xs:annotation>					<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>				</xs:annotation>			</xs:any>		</xs:sequence>	</xs:complexType>	<xs:simpleType name="noticeNumberType">		<xs:restriction base="xs:string">			<xs:maxLength value="35"/>			<xs:minLength value="1"/>		</xs:restriction>	</xs:simpleType>	<xs:complexType name="benefitInfoTypeRequest">		<xs:sequence>			<xs:element name="proactiveProcessNum" type="com:proactiveProcessNumType" minOccurs="0">				<xs:annotation>					<xs:documentation>Номер проактивного процесса</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="rowNumber" minOccurs="0">				<xs:annotation>					<xs:documentation>Номер строки реестра, по которой сформировано извещение</xs:documentation>				</xs:annotation>				<xs:simpleType>					<xs:restriction base="xs:string">						<xs:minLength value="1"/>						<xs:maxLength value="3"/>					</xs:restriction>				</xs:simpleType>			</xs:element>			<xs:choice>				<xs:element name="benefit1">					<xs:annotation>						<xs:documentation>Пособие по временной нетрудоспособности</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="lnNumber" type="com:lnCode">								<xs:annotation>									<xs:documentation>Номер ЛН</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit2">					<xs:annotation>						<xs:documentation>Пособие по беременности и родам</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="lnNumber" type="com:lnCode">								<xs:annotation>									<xs:documentation>Номер ЛН</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit4">					<xs:annotation>						<xs:documentation>Единовременное пособие при рождении ребенка</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="childSnils" type="p:snils" minOccurs="0">								<xs:annotation>									<xs:documentation>СНИЛС ребенка</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="childBirthDate" type="xs:date">								<xs:annotation>									<xs:documentation>Дата рождения ребенка</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit5">					<xs:annotation>						<xs:documentation>Ежемесячное пособие по уходу за ребенком до 1.5 лет </xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="childSnils" type="p:snils" minOccurs="0">								<xs:annotation>									<xs:documentation>СНИЛС ребенка</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="vacationPeriod" type="com:period">								<xs:annotation>									<xs:documentation>Период отпуска</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit6">					<xs:annotation>						<xs:documentation>Пособие по временной нетрудоспособности в связи с несчастным случаем на производстве или профессиональным заболеванием</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="lnNumber" type="com:lnCode">								<xs:annotation>									<xs:documentation>Номер ЛН</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit87">					<xs:annotation>						<xs:documentation>Ежемесячная выплата федеральным государственным гражданским служащим (ПП № 1652)</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="dt1" type="xs:date">								<xs:annotation>									<xs:documentation>Начало отчётного периода</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="benefit88">					<xs:annotation>						<xs:documentation>Специальная социальная выплата отдельным категориям медицинских работников (ПП РФ № 2568)</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="dt1" type="xs:date">								<xs:annotation>									<xs:documentation>Начало отчётного периода</xs:documentation>								</xs:annotation>							</xs:element>							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>								</xs:annotation>							</xs:any>						</xs:sequence>					</xs:complexType>				</xs:element>			</xs:choice>			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">				<xs:annotation>					<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>				</xs:annotation>			</xs:any>		</xs:sequence>	</xs:complexType>	<xs:simpleType name="requestTextType">		<xs:restriction base="xs:string">			<xs:minLength value="1"/>			<xs:maxLength value="4000"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="noticeReasonType">		<xs:restriction base="xs:string">			<xs:enumeration value="1">				<xs:annotation>					<xs:documentation>В соответствии с частью 20 статьи 13 Федерального закона от 29 декабря 2006 г № 255-ФЗ "Об обязательном социальном страховании на случай временной нетрудоспособности и в связи с материнством»</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="2">				<xs:annotation>					<xs:documentation>В соответствии с пунктом 32(2) Положения об оплате дополнительных расходов на медицинскую, социальную и профессиональную реабилитацию застрахованных лиц, получивших повреждение здоровья вследствие несчастных случаев на производстве и профессиональных заболеваний, утвержденного постановлением Правительства Российской Федерации от 15 мая 2006 г. № 286</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="3">				<xs:annotation>					<xs:documentation>ПП РФ от 31 декабря 2022 г. N 2568 "О дополнительной государственной социальной поддержке медицинских работников медицинских организаций, входящих в государственную и муниципальную системы здравоохранения и участвующих в базовой программе обязательного медицинского страхования либо территориальных программах обязательного медицинского страхования"</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="4">				<xs:annotation>					<xs:documentation>ПП РФ от 28 ноября 2024 г. N 1652 "Об утверждении Правил осуществления ежемесячной выплаты федеральным государственным гражданским служащим территориальных органов (органов) федеральных государственных органов, расположенных на территориях Донецкой Народной Республики, Луганской Народной Республики, Запорожской области и Херсонской области"</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:complexType name="fieldType">		<xs:sequence>			<xs:element name="field" maxOccurs="unbounded">				<xs:annotation>					<xs:documentation>Запрашиваемое поле (атрибут)</xs:documentation>				</xs:annotation>				<xs:complexType>					<xs:sequence>						<xs:element name="fieldName">							<xs:annotation>								<xs:documentation>Наименование поля</xs:documentation>							</xs:annotation>							<xs:simpleType>								<xs:restriction base="xs:string">									<xs:minLength value="1"/>								</xs:restriction>							</xs:simpleType>						</xs:element>						<xs:element name="fieldCode">							<xs:annotation>								<xs:documentation>Код поля (адрес в XML)</xs:documentation>							</xs:annotation>							<xs:simpleType>								<xs:restriction base="xs:string">									<xs:minLength value="1"/>								</xs:restriction>							</xs:simpleType>						</xs:element>					</xs:sequence>				</xs:complexType>			</xs:element>		</xs:sequence>	</xs:complexType></xs:schema>