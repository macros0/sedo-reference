<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2021 (x64) (http://www.altova.com) by BFT-Razrabotka (BFT-Razrabotka) -->
<xs:schema xmlns="urn:ru:ecp:integration:proactive:salary:proactive:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" xmlns:org="urn:ru:ecp:integration:types:organization:v3.0" xmlns:p="urn:ru:ecp:integration:types:person:v3.0" xmlns:pr="urn:ru:ecp:integration:types:proactive:type:v3.0" targetNamespace="urn:ru:ecp:integration:proactive:salary:proactive:v3.0" elementFormDefault="qualified" version="1.0">
	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>
	<xs:import namespace="urn:ru:ecp:integration:types:organization:v3.0" schemaLocation="../../type/Organization.xsd"/>
	<xs:import namespace="urn:ru:ecp:integration:types:person:v3.0" schemaLocation="../../type/Person.xsd"/>
	<xs:import namespace="urn:ru:ecp:integration:types:proactive:type:v3.0" schemaLocation="../../type/Proactive.xsd"/>
	<xs:element name="insuredPersonSalaryProactive">
		<xs:annotation>
			<xs:documentation>Сведения, необходимые для исчисления страхователем первых трех дней пособия по временной нетрудоспособности.
Тип сообщения СЭДО №32210</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="elnInfo">
					<xs:annotation>
						<xs:documentation>Информация об ЭЛН</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="lnNumber" type="com:lnCode">
								<xs:annotation>
									<xs:documentation>Номер ЭЛН</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
								</xs:annotation>
							</xs:any>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="insurerInfo">
					<xs:annotation>
						<xs:documentation>Данные о страхователе</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="regNumSFR" type="org:regNumSFR">
								<xs:annotation>
									<xs:documentation>Единый рег. номер страхователя СФР</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
								</xs:annotation>
							</xs:any>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="insuredInfo">
					<xs:annotation>
						<xs:documentation>Сведения о застрахованном лице по данным персонифицированного учета</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="snils" type="p:snils">
								<xs:annotation>
									<xs:documentation>СНИЛС</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="fullName" type="p:fullName2">
								<xs:annotation>
									<xs:documentation>ФИО</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="birthDate" type="xs:date">
								<xs:annotation>
									<xs:documentation>Дата рождения</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
								</xs:annotation>
							</xs:any>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="insuredWorksSeveralInsurers" type="xs:boolean">
					<xs:annotation>
						<xs:documentation>Застрахованное лицо на момент наступления страхового случая занято у нескольких страхователей</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="paymentMethod" type="pr:assignmentMethodType">
					<xs:annotation>
						<xs:documentation>Метод назначения и выплаты пособия</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="mobilDaysAmount" type="pr:mobilDays2YearsType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Количество дней приостановления действия трудового договора в соответствии со статьей 351.7 Трудового кодекса Российской Федерации или приостановления прохождения государственной гражданской службы в соответствии со статьей 53.1 Федерального закона от 27 июля 2004 года N 79-ФЗ "О государственной гражданской службе Российской Федерации", которые приходятся на два предшествующих года от даты начала страхового случая</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="salaryInfo">
					<xs:annotation>
						<xs:documentation>Сведения о заработке застрахованного лица</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="yearSum" type="yearSum322Type" minOccurs="2" maxOccurs="2">
								<xs:annotation>
									<xs:documentation>Сведения по году</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>
					</xs:annotation>
				</xs:any>
			</xs:sequence>
			<xs:attribute name="specVersion" type="com:specVersionType" use="required">
				<xs:annotation>
					<xs:documentation>Номер версии  спецификации для xml документа</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">
				<xs:annotation>
					<xs:documentation>Дата и время формирования сообщения на стороне СФР</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="skip">
				<xs:annotation>
					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>
				</xs:annotation>
			</xs:anyAttribute>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="yearSum322Type">
		<xs:sequence>
			<xs:element name="year">
				<xs:annotation>
					<xs:documentation>Номер года</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="pr:yearType">
						<xs:minInclusive value="2001"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="salaryByCurrentInsurer">
				<xs:annotation>
					<xs:documentation>Сумма заработка по одному (текущему) страхователю</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="sumOPS" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы застрахованного лица, включая все виды выплат и иных вознаграждений</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sumGPH" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы по гражданско-правовым договорам</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sumOPS-GPH" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы застрахованного лица, за вычетом сумм по ГПХ</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="salaryByAllInsurers">
				<xs:annotation>
					<xs:documentation>Общая сумма заработка по всем страхователям</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="sumOPS" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы застрахованного лица, включая все виды выплат и иных вознаграждений</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sumGPH" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы по гражданско-правовым договорам</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="sumOPS-GPH" type="com:amount" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Сумма заработной платы застрахованного лица, за вычетом сумм по ГПХ</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>