<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns="urn:ru:ecp:integration:proactive:responseResult:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" targetNamespace="urn:ru:ecp:integration:proactive:responseResult:v3.0" elementFormDefault="qualified" version="1.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>	<xs:element name="benefitResponseResult">		<xs:annotation>			<xs:documentation>Результат обработки ответа на запрос недостающих сведений.Тип сообщения СЭДО №10510</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="processNum" type="com:proactiveProcessNumType">					<xs:annotation>						<xs:documentation>Номер проактивного процесса</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="status" type="com:responseStatusType">					<xs:annotation>						<xs:documentation>Статус обработки сообщения №10110</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="batchNo" type="batchNoType" minOccurs="0">					<xs:annotation>						<xs:documentation>Номер сформированного документа в СФР (батч номер), например: P_1234567890_2026_05_01_1234567_0:1.Поле заполняется при статусе обработки "PROCESSED"</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="responseInfo" minOccurs="0">					<xs:annotation>						<xs:documentation>Информация об ответе страхователя (дата и время приема сообщения 10110, транспортный идентификатор сообщения 10110)</xs:documentation>					</xs:annotation>					<xs:simpleType>						<xs:restriction base="xs:string"/>					</xs:simpleType>				</xs:element>				<xs:element name="errorList" minOccurs="0">					<xs:annotation>						<xs:documentation>Информация об ошибках. Блок заполняется при статусе обработки "ERROR"</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="error" type="com:errorType" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Ошибка форматно-логического контроля</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="warnList" minOccurs="0">					<xs:annotation>						<xs:documentation>Информация о предупреждениях форматно-логических контролей</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="warn" type="com:warnType" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Предупреждение форматно-логического контроля</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии  спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор запроса (тип сообщения СЭДО №10110)</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">				<xs:annotation>					<xs:documentation>Дата и время формирования ответного сообщения на стороне СФР</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:anyAttribute processContents="skip">				<xs:annotation>					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>				</xs:annotation>			</xs:anyAttribute>		</xs:complexType>	</xs:element>	<xs:simpleType name="batchNoType">		<xs:restriction base="xs:string">			<xs:pattern value="[P]_\d{10}_(19|20)[0-9]{2}_[0|1][0-9]_[0-3][0-9]_\d{1,9}[\S]{0,5}:\d{1,3}"/>		</xs:restriction>	</xs:simpleType></xs:schema>