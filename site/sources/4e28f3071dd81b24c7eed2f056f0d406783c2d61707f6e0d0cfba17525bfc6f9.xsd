<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2021 (x64) (http://www.altova.com) by BFT-Razrabotka (BFT-Razrabotka) --><xs:schema xmlns="urn:ru:ecp:integration:vnim:notice:request:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" xmlns:p="urn:ru:ecp:integration:types:person:v3.0" xmlns:org="urn:ru:ecp:integration:types:organization:v3.0" xmlns:notice="urn:ru:ecp:integration:vnim:notice:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:notice:request:v3.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:person:v3.0" schemaLocation="../../type/Person.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:types:organization:v3.0" schemaLocation="../../type/Organization.xsd"/>	<xs:import namespace="urn:ru:ecp:integration:vnim:notice:v3.0" schemaLocation="../Notice.xsd"/>	<xs:element name="noticeRequest">		<xs:annotation>			<xs:documentation>Запрос уточненных сведений для выплаты пособий по ВНиМ, ССВ.Тип сообщения СЭДО №32</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="noticeNumber" type="notice:noticeNumberType">					<xs:annotation>						<xs:documentation>Номер запроса</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="noticeDate" type="xs:date">					<xs:annotation>						<xs:documentation>Дата формирования запроса</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="tof" type="com:territorialDivision">					<xs:annotation>						<xs:documentation>Территориальное подразделение СФР РФ</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="registryNum" minOccurs="0">					<xs:annotation>						<xs:documentation>Номер реестра (при наличии)</xs:documentation>					</xs:annotation>					<xs:simpleType>						<xs:restriction base="xs:string">							<xs:minLength value="1"/>							<xs:maxLength value="100"/>						</xs:restriction>					</xs:simpleType>				</xs:element>				<xs:element name="insuredInfo" type="notice:insuredInfoTypeRequest">					<xs:annotation>						<xs:documentation>Данные о застрахованном лице</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="insurerInfo" type="notice:insurerInfoTypeRequest">					<xs:annotation>						<xs:documentation>Данные о страхователе</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="benefitInfo" type="notice:benefitInfoTypeRequest">					<xs:annotation>						<xs:documentation>Данные о пособии</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="informationRequest">					<xs:annotation>						<xs:documentation>Запрос информации о недостающих сведениях, необходимых для назначения и выплаты пособия</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="item" maxOccurs="unbounded">								<xs:annotation>									<xs:documentation>Недостающее сведение, необходимое для назначения и выплаты пособия</xs:documentation>								</xs:annotation>								<xs:complexType>									<xs:sequence>										<xs:element name="requestText" type="notice:requestTextType">											<xs:annotation>												<xs:documentation>Текст запроса недостающего сведения</xs:documentation>											</xs:annotation>										</xs:element>										<xs:element name="requestFields" type="notice:fieldType" minOccurs="0">											<xs:annotation>												<xs:documentation>Запрашиваемые поля (атрибуты), которые должны быть направлены в сообщении №33 в ответ на запрос</xs:documentation>											</xs:annotation>										</xs:element>									</xs:sequence>								</xs:complexType>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="senderInfo">					<xs:annotation>						<xs:documentation>Данные лица, направившего запрос</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="fullName" type="p:fullNameSimple">								<xs:annotation>									<xs:documentation>ФИО работника СФР, направившего запрос</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="role" type="com:roleType">								<xs:annotation>									<xs:documentation>Должность</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="phone" type="com:phoneNumberType">								<xs:annotation>									<xs:documentation>Контактный номер телефона</xs:documentation>								</xs:annotation>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">					<xs:annotation>						<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>					</xs:annotation>				</xs:any>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageUuid101" type="com:uuidV1Type">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор сообщения СЭДО №101 (при наличии)</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">				<xs:annotation>					<xs:documentation>Дата и время формирования сообщения на стороне СФР</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:anyAttribute processContents="skip">				<xs:annotation>					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>				</xs:annotation>			</xs:anyAttribute>		</xs:complexType>	</xs:element></xs:schema>