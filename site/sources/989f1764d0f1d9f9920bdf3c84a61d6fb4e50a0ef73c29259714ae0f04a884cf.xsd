<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns="urn:ru:ecp:integration:wozm:paymentStatusNotice:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" targetNamespace="urn:ru:ecp:integration:wozm:paymentStatusNotice:v3.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../type/Common.xsd"/>	<xs:element name="paymentStatusNotice" type="PaymentNoticeType">		<xs:annotation>			<xs:documentation>Уведомление о статусе выплаты возмещения расходов страхователю.Тип сообщения СЭДО №11010</xs:documentation>		</xs:annotation>	</xs:element>	<xs:complexType name="PaymentNoticeType">		<xs:sequence>			<xs:element name="noticeType" type="NoticeTypeType">				<xs:annotation>					<xs:documentation>Тип уведомления</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="batchNo" minOccurs="0">				<xs:annotation>					<xs:documentation>Номер заявления</xs:documentation>				</xs:annotation>				<xs:simpleType>					<xs:restriction base="xs:string">						<xs:maxLength value="50"/>					</xs:restriction>				</xs:simpleType>			</xs:element>			<xs:choice>				<xs:element name="registerRecieve" type="RegisterRecieveType">					<xs:annotation>						<xs:documentation>Уведомление о поступлении информации о необходимости осуществления выплаты</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="paymentSend" type="PaymentSendType">					<xs:annotation>						<xs:documentation>Уведомление о направлении документа на оплату</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="paymentDone" type="PaymentDoneType">					<xs:annotation>						<xs:documentation>Уведомление об успешном проведении выплаты</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="paymentCanceling" type="PaymentCancelingType">					<xs:annotation>						<xs:documentation>Уведомление о недоставке платежа (оплата не прошла)</xs:documentation>					</xs:annotation>				</xs:element>			</xs:choice>			<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">				<xs:annotation>					<xs:documentation>Технический элемент, позволяющий расширять XML документ в перспективе</xs:documentation>				</xs:annotation>			</xs:any>		</xs:sequence>		<xs:attribute name="specVersion" type="com:specVersionType" use="required">			<xs:annotation>				<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>			</xs:annotation>		</xs:attribute>		<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">			<xs:annotation>				<xs:documentation>Дата и время формирования сообщения на стороне СФР</xs:documentation>			</xs:annotation>		</xs:attribute>		<xs:anyAttribute processContents="skip">			<xs:annotation>				<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>			</xs:annotation>		</xs:anyAttribute>	</xs:complexType>	<xs:simpleType name="NoticeTypeType">		<xs:restriction base="xs:integer">			<xs:enumeration value="1">				<xs:annotation>					<xs:documentation>Уведомление о поступление информации о необходимости осуществления выплаты</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="2">				<xs:annotation>					<xs:documentation>Уведомление о направлении документа на оплату</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="3">				<xs:annotation>					<xs:documentation>Уведомление об успешном проведении выплаты пособия</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="4">				<xs:annotation>					<xs:documentation>Уведомление о поступлении отказа от банка получение статуса «Оплата не прошла»</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:complexType name="RegisterRecieveType">		<xs:complexContent>			<xs:extension base="messageDetailType"/>		</xs:complexContent>	</xs:complexType>	<xs:complexType name="PaymentSendType">		<xs:complexContent>			<xs:extension base="messageDetailType"/>		</xs:complexContent>	</xs:complexType>	<xs:complexType name="PaymentDoneType">		<xs:complexContent>			<xs:extension base="messageDetailType">				<xs:sequence>					<xs:element name="summa">						<xs:annotation>							<xs:documentation>Сумма выплаты</xs:documentation>						</xs:annotation>						<xs:simpleType>							<xs:restriction base="xs:decimal">								<xs:fractionDigits value="2"/>								<xs:totalDigits value="12"/>							</xs:restriction>						</xs:simpleType>					</xs:element>				</xs:sequence>			</xs:extension>		</xs:complexContent>	</xs:complexType>	<xs:complexType name="PaymentCancelingType">		<xs:complexContent>			<xs:extension base="messageDetailType">				<xs:sequence>					<xs:element name="sum">						<xs:annotation>							<xs:documentation>Сумма выплаты</xs:documentation>						</xs:annotation>						<xs:simpleType>							<xs:restriction base="xs:decimal">								<xs:fractionDigits value="2"/>								<xs:totalDigits value="12"/>							</xs:restriction>						</xs:simpleType>					</xs:element>					<xs:element name="paymentState">						<xs:annotation>							<xs:documentation>Статус платежа (оплата не прошла)                            </xs:documentation>						</xs:annotation>						<xs:simpleType>							<xs:restriction base="xs:string">								<xs:maxLength value="64"/>							</xs:restriction>						</xs:simpleType>					</xs:element>				</xs:sequence>			</xs:extension>		</xs:complexContent>	</xs:complexType>	<xs:complexType name="messageDetailType">		<xs:sequence>			<xs:element name="infoType">				<xs:annotation>					<xs:documentation>Тип выплаты (первичная / перерасчет)</xs:documentation>				</xs:annotation>				<xs:simpleType>					<xs:restriction base="xs:integer">						<xs:enumeration value="0">							<xs:annotation>								<xs:documentation>первичная</xs:documentation>							</xs:annotation>						</xs:enumeration>						<xs:enumeration value="1">							<xs:annotation>								<xs:documentation>перерасчёт</xs:documentation>							</xs:annotation>						</xs:enumeration>					</xs:restriction>				</xs:simpleType>			</xs:element>			<xs:element name="docType" type="DocTypeType">				<xs:annotation>					<xs:documentation>Тип пособия</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType>	<xs:simpleType name="DocTypeType">		<xs:restriction base="xs:integer">			<xs:enumeration value="8">				<xs:annotation>					<xs:documentation>Возмещение расходов Страхователю на оплату четырех дополнительных  выходных дней одному из родителей (опекуну, попечителю) для ухода за детьми-инвалидами за счет средств межбюджетных трансфертов из федерального фонда</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType></xs:schema>