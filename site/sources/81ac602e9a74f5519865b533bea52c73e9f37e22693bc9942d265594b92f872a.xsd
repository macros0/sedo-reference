<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2021 (x64) (http://www.altova.com) by BFT-Razrabotka (BFT-Razrabotka) --><xs:schema xmlns="urn:ru:ecp:integration:vnim:notice:responseResult:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:notice:responseResult:v3.0">	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>	<xs:element name="noticeResponseResult">		<xs:annotation>			<xs:documentation>Результат обработки ответа на запрос уточненных сведений для выплаты пособий по ВНиМ, ССВ.Тип сообщения СЭДО №34</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="status" type="com:responseStatusType2">					<xs:annotation>						<xs:documentation>Статус обработки сообщения №33</xs:documentation>					</xs:annotation>				</xs:element>				<xs:element name="warnInfo" type="com:warnInfoType" minOccurs="0">					<xs:annotation>						<xs:documentation>Информация о предупреждениях форматно-логических контролей</xs:documentation>					</xs:annotation>				</xs:element>				<xs:choice>					<xs:element name="processedInfo">						<xs:annotation>							<xs:documentation>Информация об успешной обработке. Блок заполняется при статусе обработки "PROCESSED"</xs:documentation>						</xs:annotation>						<xs:complexType>							<xs:sequence>								<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">									<xs:annotation>										<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>									</xs:annotation>								</xs:any>							</xs:sequence>						</xs:complexType>					</xs:element>					<xs:element name="errorInfo" type="com:errorInfoType">						<xs:annotation>							<xs:documentation>Информация об ошибках. Блок заполняется при статусе обработки "ERROR"</xs:documentation>						</xs:annotation>					</xs:element>				</xs:choice>				<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">					<xs:annotation>						<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>					</xs:annotation>				</xs:any>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии  спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор запроса (тип сообщения СЭДО №33)</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">				<xs:annotation>					<xs:documentation>Дата и время формирования ответного сообщения на стороне СФР</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:anyAttribute processContents="skip">				<xs:annotation>					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>				</xs:annotation>			</xs:anyAttribute>		</xs:complexType>	</xs:element></xs:schema>
