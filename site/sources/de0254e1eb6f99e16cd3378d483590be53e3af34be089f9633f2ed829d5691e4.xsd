<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="urn:ru:ecp:integration:wozm:refund:disabilitychildren:sttmnt:result:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" targetNamespace="urn:ru:ecp:integration:wozm:refund:disabilitychildren:sttmnt:result:v3.0" elementFormDefault="qualified" version="1.0">
	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>
	<xs:element name="disabilityChildrenStatementResult" type="DisabilityChildrenResponseType">
		<xs:annotation>
			<xs:documentation>Результат обработки заявления о возмещении расходов на оплату дополнительных выходных дней для ухода за детьми инвалидами.
Тип сообщения СЭДО №12110</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="DisabilityChildrenResponseType">
		<xs:sequence>
			<xs:element name="status" type="StateType">
				<xs:annotation>
					<xs:documentation>Статус обработки заявления</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="errorList" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Список ошибок (при наличии)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="error" type="com:errorType" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Ошибка</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="specVersion" type="com:specVersionType" use="required">
			<xs:annotation>
				<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">
			<xs:annotation>
				<xs:documentation>Ссылка на транспортный идентификатор запроса (тип сообщения СЭДО №12010)</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">
			<xs:annotation>
				<xs:documentation>Дата и время формирования сообщения на стороне СФР</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:anyAttribute processContents="skip">
			<xs:annotation>
				<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>
			</xs:annotation>
		</xs:anyAttribute>
	</xs:complexType>
	<xs:simpleType name="StateType">
		<xs:restriction base="xs:integer">
			<xs:enumeration value="0">
				<xs:annotation>
					<xs:documentation>Не принят</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>Принят</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
					<xs:documentation>Произошла техническая ошибка. Необходимо повторно отправить запрос позже</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
