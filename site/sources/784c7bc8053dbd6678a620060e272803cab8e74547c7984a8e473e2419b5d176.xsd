<xs:complexType>										<xs:sequence>											<xs:element name="snils" type="p:snils">												<xs:annotation>													<xs:documentation>СНИЛС</xs:documentation>												</xs:annotation>											</xs:element>											<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">												<xs:annotation>													<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>												</xs:annotation>											</xs:any>										</xs:sequence>									</xs:complexType>								</xs:element>								<xs:element name="periodInfo">									<xs:annotation>										<xs:documentation>Сведения о запрашиваемом периоде</xs:documentation>									</xs:annotation>									<xs:complexType>										<xs:sequence>											<xs:element name="twoPrevYears">												<xs:annotation>													<xs:documentation>Два предшествующих года</xs:documentation>												</xs:annotation>												<xs:complexType>													<xs:sequence>														<xs:element name="yearSum" type="yearSum321Type" minOccurs="2" maxOccurs="2">															<xs:annotation>																<xs:documentation>Сведения по году</xs:documentation>															</xs:annotation>														</xs:element>													</xs:sequence>												</xs:complexType>											</xs:element>											<xs:element name="additionalYears" minOccurs="0">												<xs:annotation>													<xs:documentation>Дополнительно запрашиваемый период</xs:documentation>												</xs:annotation>												<xs:complexType>													<xs:sequence>														<xs:element name="yearSum" type="yearSum321Type" maxOccurs="unbounded">															<xs:annotation>																<xs:documentation>Сведения по году</xs:documentation>															</xs:annotation>														</xs:element>													</xs:sequence>												</xs:complexType>											</xs:element>										</xs:sequence>									</xs:complexType>								</xs:element>								<xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded">									<xs:annotation>										<xs:documentation>Технический элемент, позволяющий расширять XML документ</xs:documentation>									</xs:annotation>								</xs:any>							</xs:sequence>						</xs:complexType>					</xs:element>					<xs:element name="errorInfo" type="com:errorInfoType">						<xs:annotation>							<xs:documentation>Информация об ошибках. Блок заполняется при статусе обработки "ERROR"</xs:documentation>						</xs:annotation>					</xs:element>				</xs:choice>			</xs:sequence>			<xs:attribute name="specVersion" type="com:specVersionType" use="required">				<xs:annotation>					<xs:documentation>Номер версии  спецификации для xml документа</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="responseOn" type="com:uuidV1Type" use="required">				<xs:annotation>					<xs:documentation>Ссылка на транспортный идентификатор запроса (Тип сообщения СЭДО №320)</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:attribute name="messageDateTime" type="xs:dateTime" use="required">				<xs:annotation>					<xs:documentation>Дата и время формирования ответного сообщения на стороне СФР</xs:documentation>				</xs:annotation>			</xs:attribute>			<xs:anyAttribute processContents="skip">				<xs:annotation>					<xs:documentation>Технический атрибут, позволяющий расширять XML документ</xs:documentation>				</xs:annotation>			</xs:anyAttribute>		</xs:complexType>	</xs:element>	<xs:complexType name="yearSum321Type">		<xs:sequence>			<xs:element name="year">				<xs:annotation>					<xs:documentation>Номер года</xs:documentation>				</xs:annotation>				<xs:simpleType>					<xs:restriction base="pr:yearType">						<xs:minInclusive value="2001"/>					</xs:restriction>				</xs:simpleType>			</xs:element>			<xs:element name="amountForAllInsurers" type="com:amount">				<xs:annotation>					<xs:documentation>Общая сумма заработка по всем страхователям.						В сумме заработной платы застрахованного лица включены все виды выплат и иных вознаграждений в пользу застрахованного лица, которые включались в базу для начисления страховых взносов (до 2023 года за вычетом выплат по гражданско-правовым договорам, включённых в базу для начисления страховых взносов, с 2023 года с учетом выплат по гражданско-правовым договорам) и не превышают предельной величины базы для начисления страховых взносов, установленной в календарном году</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="amountForAllInsurersGph" type="com:amount" minOccurs="0">				<xs:annotation>					<xs:documentation>Общая сумма заработка по всем страхователям по гражданско-правовым договорам, включенных в базу для начисления страховых взносов</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="amountForCurrentInsurer" type="com:amount">				<xs:annotation>					<xs:documentation>Сумма заработка по одному (текущему) страхователю.						В сумме заработной платы застрахованного лица включены все виды выплат и иных вознаграждений в пользу застрахованного лица, которые включались в базу для начисления страховых взносов (до 2023 года за вычетом выплат по гражданско-правовым договорам, включённых в базу для начисления страховых взносов, с 2023 года с учетом выплат по гражданско-правовым договорам) и не превышают предельной величины базы для начисления страховых взносов, установленной в календарном году</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="amountForCurrentInsurerGph" type="com:amount" minOccurs="0">				<xs:annotation>					<xs:documentation>Сумма заработка по одному (текущему) страхователю по гражданско-правовым договорам, включенных в базу для начисления страховых взносов</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType></xs:schema>