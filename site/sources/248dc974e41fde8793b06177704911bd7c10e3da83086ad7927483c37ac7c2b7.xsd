				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="12">
							<xs:annotation>
								<xs:documentation>Вид на жительство в Российской Федерации
								</xs:documentation>
							</xs:annotation>
						</xs:enumeration>
