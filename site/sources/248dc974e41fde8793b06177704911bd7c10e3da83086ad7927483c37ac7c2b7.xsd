	</xs:simpleType>
	<xs:complexType name="residenceDocumentTypeRequest">
		<xs:annotation>
			<xs:documentation>Сведения о документах, подтверждающих постоянное или временное проживание (пребывание) на территории РФ (для иностранных граждан и лиц без гражданства)</xs:documentation>
