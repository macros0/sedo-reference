<xs:schema xmlns="urn:ru:ecp:integration:vnim:paymentStatus:request:v3.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:com="urn:ru:ecp:integration:types:common:v3.0" targetNamespace="urn:ru:ecp:integration:vnim:paymentStatus:request:v3.0">
	<xs:import namespace="urn:ru:ecp:integration:types:common:v3.0" schemaLocation="../../type/Common.xsd"/>
	<xs:element name="paymentStatusRequest">
		<xs:annotation>
			<xs:documentation>Запрос статуса выплаты пособия по ВНиМ.
Тип сообщения СЭДО №8410</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="batchNo">
					<xs:annotation>
						<xs:documentation>Номер записи реестра</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[C|E|P]_\d{10}_(19|20)[0-9]{2}_[0|1][0-9]_[0-3][0-9]_\d{4,7}[\S]{0,4}:{1,1}\d{1,3}|\S{6,18}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="receiveId">
					<xs:annotation>
						<xs:documentation>Номер реестра (файла)</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:pattern value="[C|E|P]_\d{10}_(19|20)[0-9]{2}_[0|1][0-9]_[0-3][0-9]_\d{4,7}[\S]{0,4}|\S{6,18}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:choice>
			<xs:attribute name="specVersion" type="com:specVersionType" use="required">
				<xs:annotation>
					<xs:documentation>Номер версии спецификации для xml документа</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
</xs:schema>